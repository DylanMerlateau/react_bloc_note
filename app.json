{
  "expo": {
    "name": "Bloc-note",
    "slug": "bloc-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dylan.blocnote",
      "adaptiveIcon": {
